# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/

# 1. Go to https://dashboard.emailjs.com/admin and sign up
# 2. Add Email Service (Gmail recommended)
# 3. Create TWO Email Templates:
#    - Admin notification (when someone contacts you)
#    - User auto-reply (confirmation to sender)
# 4. Copy your credentials below

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ADMIN=your_admin_template_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_USER=your_user_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
